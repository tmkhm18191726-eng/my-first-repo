{
  "name": "mimamori-call",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "dev:signal": "node -e \"require('fs').mkdirSync('out',{recursive:true})\" && wrangler dev --port 8787",
    "preview": "next build && wrangler dev --port 8787",
    "check": "node scripts/doctor.mjs",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.worker.json",
    "cf-typegen": "wrangler types"
  },
  "dependencies": {
    "next": "16.2.12",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "typescript": "^5.9.2",
    "wrangler": "^4.114.0"
  }
}
